# Copy to .env and fill in. Every key is optional: without NEBIUS_API_KEY
# the app runs in mock mode so you can click through the whole UI.

# Models: open-source models on Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# Web search, page extract and site crawl tools (https://app.tavily.com)
TAVILY_API_KEY=

# Cloud browser for bots with the Browser tool (https://www.browserbase.com)
BROWSERBASE_API_KEY=
# Optional: the project is inferred from the key when this is empty.
# BROWSERBASE_PROJECT_ID=
# Optional: how long one bot's browser session may run (default 15).
# BROWSERBASE_SESSION_MINUTES=15

# Connected apps: Slack, GitHub, Gmail, Notion and 1,000+ more (https://platform.composio.dev)
COMPOSIO_API_KEY=

# Room routing: Jev, TypeSafe's decision model, picks who answers in Auto rooms.
# Without it, Auto rooms fall back to the room's lead bot.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# Where bots, chats and MEMORY.md files live (default: ./data)
# OPENCREWBOT_DATA_DIR=./data
