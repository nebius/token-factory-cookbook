# Copy to .env and fill in. Never commit .env. Credentials stay on the server.

# Nebius Token Factory (OpenAI-compatible). Use an exact model id from GET /v1/models.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Reflection Beam on Token Factory (listed 2026-10-16). Any exact id from GET /v1/models works.
NEBIUS_MODEL=reflection/beam
# Only send generation settings the model accepts. Muse Spark Open rejects reasoning_effort none and max.
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=2048
# MODEL_REASONING_EFFORT=low

# Civo (server-side only: list clusters, fetch a kubeconfig). Never given to the agent.
CIVO_API_KEY=
CIVO_REGION=LON1
CIVO_CLUSTER_ID=

# Kubernetes: a kubeconfig file and optional context. For Civo, either this or CIVO_CLUSTER_ID.
KUBECONFIG=
KUBE_CONTEXT=
CLUSTER_KIND=kind            # kind | civo
DEMO_NAMESPACE=kubetrace-demo

# Images. Civo nodes pull from a registry; kind gets images with `kind load`.
REGISTRY=                    # e.g. ttl.sh/kubetrace-<random>  (required when CLUSTER_KIND=civo)
DOCKER_BIN=docker

# Agent limits.
MAX_AGENT_STEPS=40
MAX_RUN_SECONDS=900
MAX_RUN_TOKENS=600000
POLICY_MODE=auto             # auto (demo auto-fix) | review (approve each change)

# Optional: require this token on every /api call (set it before exposing beyond localhost).
# KUBETRACE_API_TOKEN=
