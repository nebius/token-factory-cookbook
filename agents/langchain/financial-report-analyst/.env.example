NEBIUS_API_KEY=

# Nemotron handles reasoning, synthesis, tool calls, KPI comparison, and final answers.
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_REASONING_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Cosmos handles page screenshots, charts, infographics, and visual-table checks.
NEBIUS_VISION_MODEL=nvidia/Cosmos3-Super-Reasoner
NEBIUS_VISION_BASE_URL=https://api.tokenfactory.nebius.com/v1/

FRA_ENABLE_MODEL_CALLS=1
FRA_MAX_VISION_PAGES=20
FRA_MODEL_TIMEOUT_SECONDS=180
# FRA_STORAGE_ROOT=backend/data
# FRA_DATABASE_URL=sqlite:///backend/data/financial_report_analyst.db
# FRA_CHECKPOINT_DB_PATH=backend/data/deep_agent_checkpoints.sqlite
FRA_CORS_ORIGINS=http://localhost:14321,http://127.0.0.1:14321

BACKEND_URL=http://127.0.0.1:18765
