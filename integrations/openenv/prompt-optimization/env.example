# Nebius Token Factory API key: https://tokenfactory.nebius.com/ -> profile -> API Keys
NEBIUS_API_KEY=your_api_key_here

# Optional overrides
# POLICY_MODEL=zai-org/GLM-5.3-Flash
# REFLECTOR_MODEL=moonshotai/Kimi-K3
# ACCESS_ENV_URL=http://127.0.0.1:8010

# Optional: enable the Token Factory LLM judge inside the environment server
# (adds up to +0.2 reward for the quality of the decision note)
# ACCESS_ENV_JUDGE_MODEL=zai-org/GLM-5.3-Flash
