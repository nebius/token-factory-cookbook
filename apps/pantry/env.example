# Copy to .env (chmod 600). run.sh sources this file, so quote any value that contains spaces or
# shell characters such as & or $. Only NEBIUS_API_KEY is needed for live model calls. Everything else
# is optional: leave a line commented out to use the default or the labelled local stand-in.

# Nebius Token Factory API key: https://tokenfactory.nebius.com (API keys page)
NEBIUS_API_KEY=

# Model for the conversation, request extraction and decisions.
# LLM_MODEL=moonshotai/Kimi-K3.1-Pro

# ---- Servers ----
# Address both servers listen on. The app has no sign-in, so keep the default unless you are on a
# network you trust. Use 0.0.0.0 for a LAN demo or behind a tunnel.
# PANTRY_HOST=127.0.0.1
# MCP_PORT=8701
# Base URL used in invite links and receipts.
# PUBLIC_BASE_URL=http://localhost:8700
# Base URL of the MCP server as members' own agents reach it. Used in each member's personal agent link.
# PUBLIC_MCP_URL=http://localhost:8701
# Personal MCP tokens as member:token pairs. run.sh generates these on first start; don't set by hand.
# MEMBER_TOKENS=

# ---- Local state ----
# DB_PATH=data/occasions.db
# Signs requests to the bundled demo store (occasions agent).
# STORE_SIGNING_SECRET=local-dev-signing-secret

# ---- Occasions agent (the app at /) ----
# The demo clock is pinned so the seeded calendar always has something due. ISO date.
# DEMO_TODAY=2026-11-20
# Scan the calendar on a timer. 0 scans only on demand.
# SCAN_EVERY_SECONDS=0

# ---- SingleStore: system of record (default: local SQLite in data/) ----
# SINGLESTORE_URL='mysql://user:password@host:3306/database'

# ---- Senso: verified product facts ----
# SENSO_API_KEY=
# SENSO_MCP_URL=

# ---- Cognee: per-member and household memory ----
# COGNEE_API_KEY=
# COGNEE_BASE_URL=

# ---- Firedrill: synthetic Gmail, Slack, Stripe and Google Calendar over MCP ----
# Each app is used only when its URL is set.
# FIREDRILL_GMAIL_MCP_URL=
# FIREDRILL_SLACK_MCP_URL=
# FIREDRILL_STRIPE_MCP_URL=
# FIREDRILL_GOOGLE_CALENDAR_MCP_URL=

# ---- Superlinked SIE: embedding scores for product match quality ----
# SIE_API_KEY=
# SIE_ENDPOINT=
# SIE_EMBED_MODEL=BAAI/bge-m3

# ---- Statsig (agent settings) and Amplitude (funnel events) ----
# STATSIG_SERVER_SECRET=
# AMPLITUDE_API_KEY=

# ---- Persona: sandbox identity check (occasions agent) ----
# With a key and template but without PERSONA_LIVE=1, verification is a labelled demo stand-in.
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# PERSONA_LIVE=1

# ---- Tokens& Observe: metadata-only telemetry (needs the tokensand_observe package installed) ----
# TOKENS_OBSERVE_API_KEY=
# TOKENS_OBSERVE_INGEST_URL=

# ---- Guild AI: review session for each basket plan (all three are needed) ----
# GUILD_API_KEY=
# GUILD_WORKSPACE_ID=
# GUILD_AGENT_ID=

# ---- Stripe test mode for the bundled demo store (occasions agent). Test keys only. ----
# STRIPE_SECRET_KEY=
