# The public address (link previews, canonical URLs, sitemap).
SITE_URL=http://localhost:3000

# --- Model -------------------------------------------------------------------------------------------
# An open model on Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
# deepseek-ai/DeepSeek-V4.1-Flash-1017 (the default) or moonshotai/Kimi-K3.1-Pro (about 7× the price per token)
NEBIUS_MODEL=

# --- Repos -------------------------------------------------------------------------------------------
# Raises GitHub's API limit (60 → 5,000 requests/hour). On a self-hosted instance (AUTH_MODE=none) it also opens
# private repos the token can read: a fine-grained token with "Contents: read" on those repos is enough.
GITHUB_TOKEN=
# Self-hosted only: a folder whose subfolders open at /_local/<name>, uncommitted changes included.
# Ignored when AUTH_MODE=github. In Docker, mount your code at /repos (already the default there).
LOCAL_ROOT=
# Largest repo read, in estimated tokens (the model's context is 1,048,576).
MAX_REPO_TOKENS=700000

# --- Storage -----------------------------------------------------------------------------------------
# Everything Codetrail stores: repo files (with full-text search), maps, tours, answers, docs, costs, accounts.
# A local SQLite file by default; libsql://… for Turso when hosted.
DATABASE_URL=file:codetrail.db
DATABASE_AUTH_TOKEN=

# --- Hosted limits -----------------------------------------------------------------------------------
# Hosted only: new AI calls stop for the day after this much spend. Empty or 0 = no cap (local default).
DAILY_BUDGET_USD=
# "none" (default): nobody signs in. "github": new reads and questions need GitHub sign-in.
AUTH_MODE=none
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Free quota per account per UTC day when AUTH_MODE=github.
QUOTA_READS_PER_DAY=3
QUOTA_ASKS_PER_DAY=20
