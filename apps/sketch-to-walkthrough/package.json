{
  "name": "sketch-to-walkthrough",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "node scripts/generate-samples.mjs",
    "qa": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "dotenv": "^17.2.3",
    "hono": "^4.10.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
