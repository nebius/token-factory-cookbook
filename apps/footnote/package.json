{
  "name": "footnote",
  "version": "0.1.0",
  "description": "Drop in a filing or report PDF. Inkling 2 Small builds a spreadsheet model where every number is footnoted to its page, and checks the report's own claims with Python.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.mts",
    "recheck": "tsx scripts/recheck.mts",
    "score:transcription": "tsx scripts/score-transcription.mts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "exceljs": "4.4.0",
    "jsonrepair": "^3.15.0",
    "next": "16.4.3",
    "openai": "^7.55.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
