# Inkling 2 Small on Nebius Token Factory: https://tokenfactory.nebius.com (API keys page)
NEBIUS_API_KEY=

# Optional overrides
# INKLING_MODEL=thinkingmachines/Inkling-2-Small
# NEBIUS_BASE_URL=https://api.tokenfactory.eu-west2.nebius.com/v1/
# FOOTNOTE_DATA_DIR=data

# Your Token Factory price in dollars per million tokens, so the run log can show what each call cost.
# These are the list prices on 13 November 2026; clear them to hide cost.
INKLING_PRICE_INPUT=0.3
INKLING_PRICE_CACHED=0.06
INKLING_PRICE_OUTPUT=1

# Optional: the Python that run_python uses. It runs sandboxed (sandbox-exec on macOS, unshare on
# Linux); where neither works the tool is off unless you set FOOTNOTE_PYTHON=unsandboxed.
# FOOTNOTE_PYTHON_BIN=python3
# FOOTNOTE_PYTHON=

# Development only: "replay" runs the bundled EIA example from fixtures/replays with no model call,
# and INKLING_RECORD=1 saves live replies there.
# INKLING_PROVIDER=replay
# INKLING_RECORD=1
