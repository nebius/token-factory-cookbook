# Server-side only. Enter actual values locally; never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_SUBNET_ID=
# Required for stream-host-v2's recommended warm GPU training/serving path.
CARETAKER_WORKER_URL=
CARETAKER_WORKER_TOKEN=
# Provisioning only: compatible persistent filesystem for the GPU worker.
TRAINING_FILESYSTEM_ID=
# TAVILY_API_KEY can remain blank when tvly login is authenticated.
# AI Cloud authentication comes from the nebius CLI profile, separately.
# Leave GAME_DATA_DIR unset to retain the default private .runtime directory.
