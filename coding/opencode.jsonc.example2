{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nebius-token-factory-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nebius Token Factory (Custom)",
      "options": {
        "baseURL": "https://api.tokenfactory.nebius.com/v1",
      },
      "models": {
        "zai-org/GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1048576, "output": 1048576 },
          "cost": { "input": 0.15, "output": 0.5 }
        },
        "MiniMaxAI/MiniMax-M3": {
          "name": "MiniMax-M3",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1048576, "output": 1048576 },
          "cost": { "input": 0.3, "output": 1.2 }
        },
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek-V4-Flash-0731",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1048576, "output": 1048576 },
          "cost": { "input": 0.14, "output": 0.28, "cache_read": 0.14 }
        },
        "moonshotai/Kimi-K3": {
          "name": "Kimi-K3",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1048576, "output": 8000 },
          "cost": { "input": 3, "output": 15, "cache_read": 3 }
        },
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi-K2.7-Code",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 262144, "output": 8000 },
          "cost": { "input": 0.95, "output": 4 }
        },
        "zai-org/GLM-5.2": {
          "name": "GLM-5.2",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1048576, "output": 1048576 },
          "cost": { "input": 1.4, "output": 4.4 }
        },
      }
    }
  }
}