# Nebius Token Factory key - create one at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Live model IDs for Droid, comma separated.
# Pick them from: python scripts/list_models.py
TF_MODELS=

# Optional: most tokens Droid may ask for in one reply (default 16384).
TF_MAX_OUTPUT_TOKENS=

# Optional: map a Token Factory model to the Droid built-in model it behaves
# like, as <token-factory-id>=<droid-model-id>, comma separated. Use it when
# Droid says a custom model "does not map to a built-in model".
TF_BASE_MODEL_IDS=

# Optional: models from TF_MODELS, comma separated, that still answer
# "400 ... missing its reasoning" in Droid. See Troubleshooting in the README.
TF_ALLOW_MISSING_THINKING=
