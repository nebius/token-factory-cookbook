# Nebius Token Factory key - create one at https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Any long random string. It is the password between Claude Code and your local
# proxy, not a Nebius credential. Generate one with: openssl rand -hex 24
LITELLM_MASTER_KEY=

# Live model IDs. Pick them from: uv run --env-file .env python scripts/list_models.py
# TF_MAIN_MODEL answers your prompts; TF_FAST_MODEL does Claude Code's background work.
TF_MAIN_MODEL=
TF_FAST_MODEL=

# Optional: more live model IDs to expose through the proxy, comma separated.
TF_EXTRA_MODELS=

# Optional: port for the local proxy (default 4000).
LITELLM_PORT=
